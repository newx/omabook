# Maintainer: Newton Ramos Garcia <n@newx.sh>

pkgname=omabook
pkgver=0.1.0
pkgrel=1
pkgdesc='Book library and reader built with Qt Quick'
arch=('x86_64')
url='https://github.com/newx/omabook'
license=('MIT')

depends=(
  'hicolor-icon-theme'
  # poppler is not optional: pdftotext and pdftoppm are how PDF covers, page
  # text, and text-quality assessment work, and PDFs are half of a typical
  # library.
  'poppler'
  'qt6-base'
  'qt6-declarative'
  # Without the ffmpeg backend QMediaPlayer plays nothing at all, and reports
  # no error while doing it -- reading aloud is simply silent.
  'qt6-multimedia'
  'qt6-multimedia-ffmpeg'
  # Some EPUB covers are WebP. Without this, QImageReader decodes them to
  # nothing and the book gets no cover, again with no error.
  'qt6-imageformats'
  # Reader.qml imports QtTextToSpeech. An unresolvable QML import is not an
  # error the app can see: the reader silently fails to load and a book opens
  # onto an empty pane. Nothing catches it earlier either -- the module is
  # loaded as a QML plugin, so the binary does not link it and the build
  # succeeds without it.
  'qt6-speech'
  'qt6-svg'
  'qt6-webchannel'
  'qt6-webengine'
  'xdg-desktop-portal'
)

makedepends=('qt6-base' 'git')

# Everything the app can live without. The library, reader, search, highlights
# and import all work with none of these installed.
optdepends=(
  'ollama: local summaries, questions and search indexing'
  'docker: local text-to-speech via the Kokoro container'
  'calibre: extract MOBI and AZW3 text for search and questions'
  'speech-dispatcher: fallback system voice when Kokoro is not running'
  'flite: fallback system voice, if speech-dispatcher is not wanted'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 build/omabook "$pkgdir/usr/bin/omabook"
  install -Dm644 pkgbuild/omabook.desktop "$pkgdir/usr/share/applications/omabook.desktop"
  install -Dm644 pkgbuild/omabook.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omabook.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # The reader ships as data rather than embedded, so it can load book files
  # from disk: a qrc: page cannot.
  install -dm755 "$pkgdir/usr/share/omabook"
  cp -r assets/reader "$pkgdir/usr/share/omabook/reader"
  find "$pkgdir/usr/share/omabook" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/omabook" -type f -exec chmod 644 {} +
}
