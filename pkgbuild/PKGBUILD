# Maintainer: Newton Ramos Garcia <n@newx.sh>

pkgname=omabook
pkgver=0.1.0
pkgrel=1
pkgdesc='Book library and reader built with Qt Quick'
arch=('x86_64')
url='https://github.com/newx/omabook'
license=('MIT')

depends=(
  'hicolor-icon-theme'
  # poppler is not optional: pdftotext and pdftoppm are how PDF covers, page
  # text, and text-quality assessment work, and PDFs are half of a typical
  # library.
  'poppler'
  'qt6-base'
  'qt6-declarative'
  # Some EPUB covers are WebP. Without this, QImageReader decodes them to
  # nothing and the book gets no cover, again with no error.
  'qt6-imageformats'
  'qt6-svg'
  'qt6-webchannel'
  'qt6-webengine'
  'xdg-desktop-portal'
)

makedepends=('qt6-base')

# No source array: this builds the checkout it sits in, the way omawrite's
# PKGBUILD does. Fetching a release tarball would be right for the AUR and
# wrong for `bin/install`, which is how anyone actually installs this today --
# there is no tagged release to fetch.
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

check() {
  cd "$startdir/.."
  ./bin/test
}

package() {
  cd "$startdir/.."

  /usr/bin/install -Dm755 build/omabook "$pkgdir/usr/bin/omabook"
  /usr/bin/install -Dm644 pkgbuild/omabook.desktop \
    "$pkgdir/usr/share/applications/omabook.desktop"
  /usr/bin/install -Dm644 pkgbuild/omabook.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/omabook.svg"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The reader engine is vendored into this package, so its licence ships too.
  /usr/bin/install -Dm644 assets/reader/foliate-js/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.foliate-js"

  # The reader ships as data rather than embedded, so it can load book files
  # from disk: a qrc: page cannot.
  /usr/bin/install -dm755 "$pkgdir/usr/share/omabook"
  cp -r assets/reader "$pkgdir/usr/share/omabook/reader"

  # foliate-js is vendored verbatim, so upstream's repository metadata and CI
  # configuration come with it. None of that is of use to anyone installing a
  # book reader. foliate-js.version stays: it is what says which engine this is.
  local _fj="$pkgdir/usr/share/omabook/reader/foliate-js"
  rm -rf "$_fj/.github" "$_fj/.gitignore" "$_fj/.gitattributes" \
         "$_fj/tests" "$_fj/node_modules"

  find "$pkgdir/usr/share/omabook" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/omabook" -type f -exec chmod 644 {} +
}
