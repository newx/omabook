#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PKGBUILD_DIR="$ROOT/pkgbuild"

if ! command -v makepkg >/dev/null 2>&1; then
  echo "makepkg is required to build and install the Arch package." >&2
  exit 1
fi

# The reader engine is not vendored and is gitignored, because it is a separate
# project with its own history. Without it omabook builds and the library works,
# but opening a book renders nothing at all.
if [ ! -f "$ROOT/assets/reader/foliate-js/view.js" ]; then
  echo "Fetching the reader engine (foliate-js)..."
  git clone --depth 1 https://github.com/johnfactotum/foliate-js.git \
    "$ROOT/assets/reader/foliate-js"
fi

"$ROOT/bin/build"

cd "$PKGBUILD_DIR"
exec makepkg -fsi "$@"
