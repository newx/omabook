#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PKGBUILD_DIR="$ROOT/pkgbuild"

if ! command -v makepkg >/dev/null 2>&1; then
  echo "makepkg is required to build and install the Arch package." >&2
  exit 1
fi

# The reader engine is vendored in assets/reader/foliate-js. Without it omabook
# builds and the library works, but opening a book renders nothing at all, so
# fail here rather than at the first book someone opens.
if [ ! -f "$ROOT/assets/reader/foliate-js/view.js" ]; then
  echo "assets/reader/foliate-js is missing or incomplete." >&2
  echo "Restore it with: bin/vendor-foliate-js" >&2
  exit 1
fi

"$ROOT/bin/build"

cd "$PKGBUILD_DIR"
exec makepkg -fsi "$@"
